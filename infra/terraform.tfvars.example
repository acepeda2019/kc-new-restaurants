# Copy to terraform.tfvars (git-ignored) and fill in. Never put secrets here:
# pass the optional Socrata token as TF_VAR_socrata_app_token.

aws_region       = "us-west-2"
data_bucket_name = "<globally-unique-data-bucket-name>"
alert_emails     = ["<you@example.com>"]

# Principals allowed to delete or overwrite raw/ (e.g. your admin SSO role).
# Include the principal you run Terraform as.
raw_admin_principal_arns = [
  "arn:aws:iam::<account-id>:role/aws-reserved/sso.amazonaws.com/*/AWSReservedSSO_AdministratorAccess_*",
]

# Requires the extractors to send IfNoneMatch="*" on put_object.
raw_enforce_create_only = true

github_repo        = "<owner>/<repo>"
github_environment = "prod"
# Set false if the account already has the token.actions.githubusercontent.com provider.
create_github_oidc_provider = true

# Daily at 06:00 Pacific. Set schedule_enabled = false for the first apply,
# test with a manual execution, then enable.
schedule_expression = "cron(0 6 * * ? *)"
schedule_timezone   = "America/Los_Angeles"
schedule_enabled    = false

# lambda_zip_path = "../ingestion/dist/lambda.zip"  # default
log_level          = "INFO"
log_retention_days = 30

aws_monthly_budget_usd = 5

# Snowflake account identifier <org>-<account>
snowflake_organization_name = "<ORG>"
snowflake_account_name      = "<ACCOUNT>"

# Resource monitor quota = floor(budget / credit price) credits per month.
# Check your credit price in Snowsight: Admin > Billing & Terms.
snowflake_monthly_budget_usd = 10
snowflake_credit_price_usd   = 3
# snowflake_credit_quota_override = 4
snowflake_monitor_notify_users = []

# Public key for the GitHub Actions service user (PEM body without the
# BEGIN/END lines). Leave unset to skip creating the user.
# snowflake_pipeline_user_rsa_public_key = "MIIBIjANBgkq..."
