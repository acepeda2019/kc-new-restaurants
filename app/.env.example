# Copy to .env.local for local runs; set the real values in Vercel env vars. Never commit them.
# Shared passcode friends type on /login.
APP_PASSCODE=
# HMAC key for the session cookie. Generate with: openssl rand -base64 32
SESSION_SECRET=
# Upstash Redis for the /api/ask daily caps (set by Vercel's Upstash integration). Unset → questions are refused.
KV_REST_API_URL=
KV_REST_API_TOKEN=
# Dedicated Claude key for /api/ask. Unset → questions are refused, Claude is never called.
ANTHROPIC_API_KEY=
